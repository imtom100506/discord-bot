DISCORD_TOKEN=
GROQ_API_KEY=
# Opcional: respaldo gratuito, habilitado al completar ambos valores.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Registros de errores, actividad y moderación.
# Sin ID: busca el canal existente logs-tars del servidor; con ID, este tiene prioridad.
LOG_CHANNEL_ID=
# Opcional: canal privado para persistir los mutes; por defecto usa LOG_CHANNEL_ID.
TARS_STATE_CHANNEL_ID=
# Solo sin canal de estado/logs: carpeta en disco persistente (por defecto data/).
TARS_DATA_DIR=
# El alojamiento suele asignarlo automáticamente.
PORT=3000
# Voz: requiere Docker con Piper/ffmpeg y canal de estado/logs.
TARS_VOICE_ENABLED=false
# Opcional: detector local; sin configurar se conserva /escuchar.
TARS_WAKE_ENABLED=false
# Única voz: Piper es_MX-claude INT8; no hay fallback a otro motor.
TARS_TTS_ENGINE=piper
# Global por defecto; false conserva captura manual/Hey TARS anterior.
TARS_GLOBAL_LISTENING=true
# Groq Free: Whisper por lotes. Deepgram no cumple gratuidad continua y se rechaza.
TARS_STT_PROVIDER=groq
# En modo global exige TARS o pregunta directa (no evita enviar voz aceptada a STT).
TARS_WAKE_REQUIRED=true
TARS_HUMOR=75
# Protección de eco: false descarta recepción durante reproducción y 200 ms después.
TARS_ALLOW_BARGE_IN=false
# Los registros de conversación global en Discord requieren activación explícita.
TARS_VOICE_LOG_ENABLED=false
# Opcional: ruta alternativa a models/silero_vad.onnx.
TARS_VAD_MODEL=
# Sin espera artificial; siguen activos presupuesto y Retry-After.
TARS_VOICE_SPACING_MS=0

# Límites INTERNOS independientes; no modifican cuotas del proveedor ni el tope diario.
TARS_LLM_REQUESTS_PER_MINUTE=6
TARS_STT_REQUESTS_PER_MINUTE=20
# Silencio para cerrar una intervención; evita cortar frases en pausas breves.
TARS_VAD_ENDPOINT_MS=650
